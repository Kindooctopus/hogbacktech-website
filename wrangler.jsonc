{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Marketing site Worker (hogbacktech.com). Local deploys: npm run deploy
  "name": "hogbacktech-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Run the Worker on every request so HTML page views can be counted.
    // /api/* is handled in worker/index.ts; everything else falls through to ASSETS.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT",
      "id": "cfc110435fd8459a9b9f3e3e53026b6a",
      "preview_id": "cfc110435fd8459a9b9f3e3e53026b6a"
    }
  ],
  // Daily digests at 15:00 UTC (7:00 AM Pacific). Weekly digest also sends on Mondays.
  // Note: Analytics Engine is intentionally omitted — it requires a one-time dashboard
  // enablement and breaks Workers Builds with no_access_to_analytics_engine until then.
  // Daily rollups live in CONTENT KV (analytics:day:*).
  "triggers": {
    "crons": ["0 15 * * *"]
  }
}
