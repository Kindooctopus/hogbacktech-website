{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Marketing site Worker (hogbacktech.com). Local deploys: npm run deploy
  "name": "hogbacktech-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Route /api/* through the Worker before static assets so content edits work.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT",
      "id": "cfc110435fd8459a9b9f3e3e53026b6a",
      "preview_id": "cfc110435fd8459a9b9f3e3e53026b6a"
    }
  ]
}
